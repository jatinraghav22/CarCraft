# Django Secret Key (Production should use a 50+ char random secret)
DJANGO_SECRET_KEY=django-insecure-replace-with-your-own-secret-key-in-production
SECRET_KEY=django-insecure-replace-with-your-own-secret-key-in-production

# Debug Mode (False in production)
DEBUG=False

# Allowed Hosts (comma-separated, include your Render URL)
ALLOWED_HOSTS=car-craft.onrender.com,localhost,127.0.0.1

# CORS Allowed Origins (include your Vercel deployment URL)
CORS_ALLOWED_ORIGINS=https://your-carcraft-frontend.vercel.app,http://localhost:5173

# CSRF Trusted Origins (include both backend and frontend domains)
CSRF_TRUSTED_ORIGINS=https://car-craft.onrender.com,https://your-carcraft-frontend.vercel.app

# Production PostgreSQL Database URL (provided by Render PostgreSQL)
# Example: postgresql://carcraft_user:password@dpg-xxxxxx.oregon-postgres.render.com/carcraft_db
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Local Database Fallback (used when DATABASE_URL is not provided)
# DB_ENGINE: 'mysql' or 'sqlite'
DB_ENGINE=sqlite
DB_NAME=carcraft_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# Simple JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
